# Образец файла .env. Скопируй его в .env, если нужно поменять настройки.
# Сам .env в git не попадает.

# true — всегда показывать сохранённый пример плана из examples/demo_responses/
# и не тратить бесплатные запросы, даже если ключ введён.
# false (или строки нет) — обычная работа: с ключом план составляет Gemini,
# без ключа показывается тот же сохранённый пример.
DEMO_MODE=false
